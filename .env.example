# Salin file ini jadi .env lalu isi sesuai kebutuhan.
# File .env tidak boleh ikut di-commit.

# ==========================================================
# SUMBER DATA SERP
# ==========================================================
# Pilihan: serper | google_cse | manual
SERP_PROVIDER=manual

# Serper.dev — https://serper.dev (ada kuota gratis)
SERPER_API_KEY=

# Google Custom Search JSON API
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Negara dan bahasa pencarian
SERP_COUNTRY=id
SERP_LANGUAGE=id

# Jumlah hasil SERP yang diambil
SERP_TOP_N=10

# Berapa lama hasil SERP disimpan sebelum diambil ulang
SERP_CACHE_TTL_HOURS=12


# ==========================================================
# CRAWLER
# ==========================================================
# Jumlah halaman kompetitor yang benar-benar di-crawl
CRAWL_TOP_N=10

# Jeda antar request saat crawl, dalam detik
CRAWL_DELAY_SECONDS=1.0

# Ambil setiap halaman dua kali (Chrome dan Googlebot) untuk
# mendeteksi cloaking dan domain bajakan. Menggandakan jumlah
# request, tapi tanpa ini blueprint bisa tersusun dari konten
# halaman institusi yang dibobol, bukan dari halaman yang ngerank.
CLOAK_CHECK=true

# Ambang keyakinan (0-100) sebelum satu halaman divonis bajakan
# dan dikeluarkan dari perhitungan target.
HIJACK_MIN_CONFIDENCE=60


# ==========================================================
# AI
# ==========================================================
AI_PROVIDER=ollama
AI_MODEL=qwen3:4b-instruct

# Naikkan kalau model sering memotong jawaban.
# Turunkan kalau proses terlalu lama di CPU.
AI_MAX_TOKENS_INSIGHT=2500
AI_MAX_TOKENS_PLAN=5000

# Ukuran context. Jangan diturunkan di bawah 16384 kalau meng-crawl
# 10 kompetitor: prompt yang tidak muat akan dipotong Ollama tanpa
# error, dan hasil analisisnya jadi ngawur tanpa ketahuan.
AI_CONTEXT_LENGTH=16384

# Jeda maksimal antar token, BUKAN batas waktu total.
# Menulis 5000 token di CPU bisa makan 30 menit, jadi batas total
# berapa pun akan salah. Yang menandakan masalah adalah token yang
# berhenti mengalir.
AI_STALL_TIMEOUT_SECONDS=180
AI_CONNECT_TIMEOUT_SECONDS=15


# ==========================================================
# WEB APP
# ==========================================================
# Kunci penanda tangan cookie sesi. Dibuat otomatis oleh serve.py
# pada run pertama. Kalau kosong, web_app membuat kunci acak per
# proses, sehingga sesi login berakhir tiap server dimatikan.
# JANGAN dibagikan dan jangan di-commit.
NEIIU_SESSION_SECRET=


# ==========================================================
# IDENTITAS SITUS
# ==========================================================
# Dipakai untuk canonical, sitemap, dan structured data.
# Wajib diganti ke domain asli sebelum halaman diunggah.
SITE_NAME=NEIIU
SITE_BASE_URL=https://example.com
SITE_LOCALE=id_ID

# Catatan yang ditempel di footer. Kosongkan kalau tidak perlu.
SITE_DISCLAIMER=
